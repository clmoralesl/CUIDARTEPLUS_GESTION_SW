{
  "name": "@cuidarte/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de CuidartePlus Gestión (NestJS)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @cuidarte/core build && tsc -p tsconfig.build.json && concurrently -k -n core,tsc,api -c cyan,yellow,green \"pnpm --filter @cuidarte/core dev\" \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"nodemon dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cuidarte/core": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "pg": "^8.23.1",
    "reflect-metadata": "~0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.14",
    "vitest": "^3.2.7"
  }
}
